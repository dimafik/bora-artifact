# credentials — never commit
*.pem
*.key
*.ppk
id_rsa*
*.pfx
*.p12

# bulk regenerable artefacts
*.parquet
# predictor_daemon.log was ignored as bulk output.  It is not: the mldetect
# runs' copies are the only evidence for the paper's detection latency and
# false-positive count, so they are tracked explicitly.
predictor_daemon.log
!02_results_raw/mldetect_*/predictor_daemon.log
caliper-seed*.log

# os noise
Thumbs.db
.DS_Store

# python bytecode
__pycache__/
*.pyc

# TLC run output
05_formal/tla/states/
# tlapm's fingerprint cache: regenerable, and shipping it would let
# run_tlapm.sh report success without discharging a single obligation.
05_formal/tla/.tlacache/

# working backups
*.bak_*
